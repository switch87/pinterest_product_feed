
<odoo>
    <data>
        <!-- Main Menu -->
        <menuitem id="menu_product_feed_root" name="Product Feeds" sequence="10"/>

        <!-- Submenu -->
        <menuitem id="menu_product_feed_config" name="Feed Configurations" parent="menu_product_feed_root" action="action_product_feed_config"/>

        <!-- Action for the unified model -->
        <record id="action_product_feed_config" model="ir.actions.act_window">
            <field name="name">Product Feed Configurations</field>
            <field name="res_model">product.feed.config</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Tree View -->
        <record id="view_product_feed_config_tree" model="ir.ui.view">
            <field name="name">product.feed.config.tree</field>
            <field name="model">product.feed.config</field>
            <field name="arch" type="xml">
                <tree string="Product Feed Configurations">
                    <field name="name"/>
                    <field name="feed_type"/>
                    <field name="website_id"/>
                    <field name="active"/>
                    <field name="last_sync_date"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_product_feed_config_form" model="ir.ui.view">
            <field name="name">product.feed.config.form</field>
            <field name="model">product.feed.config</field>
            <field name="arch" type="xml">
                <form string="Product Feed Configuration">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="feed_type"/>
                            <field name="website_id"/>
                            <field name="feed_token"/>
                            <field name="active"/>
                            <field name="last_sync_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
